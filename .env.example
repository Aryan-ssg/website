# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored; this example file contains names only.

# Public site URL, used for links, redirects and OAuth callbacks.
NEXT_PUBLIC_SITE_URL=

# Supabase project settings (Project Settings -> API).
# Both are safe to expose to the browser; access is controlled by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never rename this to NEXT_PUBLIC_* and never send it to the browser.
SUPABASE_SERVICE_ROLE_KEY=


# ---------------------------------------------------------------------------
